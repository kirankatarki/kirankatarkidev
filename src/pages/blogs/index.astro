---
import Base from '../../layouts/Base.astro';
import { getAllPosts } from '../../lib/sanity';

const posts = await getAllPosts();

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
  });
}
---

<Base title="Blogs - Kiran Katarki">
  <div class="max-w-5xl mx-auto px-9 py-11">

    <h1 class="text-[26px] font-medium text-text mb-8">Blog</h1>

    <div>
      {posts.map((post: any, i: number) => (
        <a
          href={`/blogs/${post.slug.current}`}
          class={[
            'flex items-start justify-between py-5 hover:text-accent transition-colors group',
            i < posts.length - 1 ? 'border-b border-border' : '',
          ].join(' ')}
        >
          <div class="flex-1 pr-8">
            <h2 class="text-[13px] font-medium text-text group-hover:text-accent transition-colors mb-1">
              {post.title}
            </h2>
            {post.excerpt && (
              <p class="text-[11px] text-muted leading-[1.5] mb-2">
                {post.excerpt}
              </p>
            )}
            {post.tags && post.tags.length > 0 && (
              <div class="flex gap-[5px]">
                {post.tags.map((tag: string) => (
                  <span class="text-[11px] px-[9px] py-0.5 rounded-[4px] bg-accent-secondary/10 text-accent-secondary">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
          <div class="shrink-0 text-right">
            {post.publishedAt && (
              <span class="text-[11px] text-muted">
                {formatDate(post.publishedAt)}
              </span>
            )}
            {post.readingTime && (
              <p class="text-[11px] text-muted mt-0.5">
                {post.readingTime} min read
              </p>
            )}
          </div>
        </a>
      ))}

      {posts.length === 0 && (
        <p class="text-[13px] text-muted py-5">No posts yet.</p>
      )}
    </div>

  </div>
</Base>