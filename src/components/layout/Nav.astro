---
const navLinks = [
    { href: '/projects', label: 'projects'},
    { href: '/blogs', label: 'blogs'},
    { href: '/case-studies', label: 'case studies'},
    { href: '/contact', label: 'contact'}
];

const pathname = Astro.url.pathname;
---

<header class="bg-surface border-b border-border">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">

    <a href="/" class="text-text font-semibold text-lg tracking-tight">
      Kiran Katarki
    </a>

    <div class="flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={[
            'text-sm transition-colors',
            link.href === '/contact'
              ? 'text-accent font-medium'
              : 'text-muted hover:text-text',
            pathname.startsWith(link.href)
              ? 'text-text font-medium'
              : '',
          ].join(' ')}
        >
          {link.label}
        </a>
      ))}

      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="text-muted hover:text-text transition-colors"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>

  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const html = document.documentElement;

  function syncIcon() {
    if (html.classList.contains('dark')) {
      iconSun?.classList.remove('hidden');
      iconMoon?.classList.add('hidden');
    } else {
      iconSun?.classList.add('hidden');
      iconMoon?.classList.remove('hidden');
    }
  }

  syncIcon();

  toggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    syncIcon();
  });
</script>