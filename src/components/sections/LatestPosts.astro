---
import { getAllPosts } from '../../lib/sanity';

const allPosts = await getAllPosts();
const posts = allPosts.slice(0, 2);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
  });
}
---

<section class="max-w-5xl mx-auto px-9 py-7">

  <p class="text-[11px] uppercase tracking-[1.2px] text-muted mb-3">
    Latest posts
  </p>

  <div>
    {posts.map((post: any, i: number) => (
      <a
        href={`/blogs/${post.slug.current}`}
        class={[
          'flex items-center justify-between py-3 hover:text-accent transition-colors',
          i < posts.length - 1 ? 'border-b border-border' : '',
        ].join(' ')}
      >
        <h3 class="text-[13px] font-medium text-text">{post.title}</h3>
        <span class="text-[11px] text-muted ml-8 shrink-0">
          {post.publishedAt ? formatDate(post.publishedAt) : ''}
        </span>
      </a>
    ))}

    {posts.length === 0 && (
      <p class="text-[13px] text-muted py-3">No posts yet.</p>
    )}
  </div>

</section>

<div class="max-w-5xl mx-auto px-9">
  <hr class="border-divider" />
</div>